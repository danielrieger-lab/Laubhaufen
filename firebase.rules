rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /recipes/{recipeId} {
      allow read, write: if request.auth != null;
    }

    match /weeklyMeals/{mealId} {
      allow read, write: if request.auth != null;
    }

    match /shoppingItems/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /pantryItems/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}
